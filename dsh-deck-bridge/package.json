{
  "name": "dsh-deck-bridge",
  "version": "0.4.0",
  "description": "Agent Deck companion bridge for DeepSeek Harness Web: pushes session changes to the companion and switches sessions over authenticated DSH /api long polling with an acknowledgement. No mouse simulation or Chrome scripting permission is required.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2 || ^0.2.0-rc.2"
  },
  "license": "MIT"
}
