{
  "manifest_version": 1,
  "id": "codex",
  "display_name": "Codex CLI",
  "built_in": true,
  "detection": {
    "process_names": ["codex"],
    "exclude_argv_patterns": ["/ChatGPT.app/"]
  },
  "surfaces": ["terminal", "herdr_pane"],
  "default_surface": "terminal",
  "hooks": {
    "config_relative": ".codex/hooks.json",
    "handler_format": "codex",
    "events": ["SessionStart", "UserPromptSubmit", "PreToolUse", "PermissionRequest", "PostToolUse", "SubagentStart", "SubagentStop", "Stop", "SessionEnd"]
  },
  "keymap": {
    "terminal": {
      "K1": { "label": "PANEL 1", "hint": "Active Panel 1", "action": { "type": "active_panel", "slot": 1 } },
      "K2": { "label": "PANEL 2", "hint": "Active Panel 2", "action": { "type": "active_panel", "slot": 2 } },
      "K3": { "label": "PANEL 3", "hint": "Active Panel 3", "action": { "type": "active_panel", "slot": 3 } },
      "K4": { "label": "OK", "hint": "y + Enter", "action": { "type": "text_input", "text": "y", "submit": true } },
      "K5": { "label": "NO", "hint": "n + Enter", "action": { "type": "text_input", "text": "n", "submit": true } },
      "K6": { "label": "VIEW", "hint": "Ctrl+O", "action": { "type": "shortcut", "key": "o", "modifiers": ["control"] } },
      "K7": { "label": "STOP", "hint": "Ctrl+C", "action": { "type": "shortcut", "key": "c", "modifiers": ["control"] } },
      "K8": { "label": "SEND", "hint": "Enter", "action": { "type": "shortcut", "key": "enter" } },
      "K9": { "label": "FORK", "hint": "/fork + Enter", "action": { "type": "text_input", "text": "/fork", "submit": true } },
      "K10": { "label": "", "hint": "", "action": { "type": "disabled" } }
    }
  }
}
